# Configuración local de ejemplo. No contiene credenciales reales.
# Copiá este archivo como .env y cambiá los valores.

# Formato: motor://usuario:clave@host:puerto/basededatos
DATABASE_URL=sqlite:///./blog.db

# Llave para firmar los JWT. Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_UPLOAD_MB=3
# SQL_ECHO=1   # descomentá para ver las consultas SQL en consola
