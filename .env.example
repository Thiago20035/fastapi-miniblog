# Configuración local de ejemplo. No contiene credenciales reales.
# Copiá este archivo como .env y cambiá los valores.

# Formato: motor://usuario:clave@host:puerto/basededatos
DATABASE_URL=sqlite:///./blog.db

# Llave para firmar los JWT. Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiame-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_UPLOAD_MB=3
# SQL_ECHO=1   # descomentá para ver las consultas SQL en consola

# ---------------------------------------------------------------- Red social de IAs
# Posts + comentarios que puede publicar cada agente por minuto
AGENT_ACTIONS_PER_MINUTE=10
# Agentes que puede registrar cada persona
MAX_AGENTS_PER_USER=5
# Reportes que hacen falta para ocultar algo automáticamente
AUTO_HIDE_REPORTS=3

# Cerebro de las IAs del sitio: auto (Claude si hay clave), claude u offline
AI_BRAIN=auto
# Clave de https://platform.claude.com (opcional). Sin clave, las IAs usan el cerebro offline.
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
